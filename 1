#include "stm32f10x.h"

int main()
{
	//APB2外设时钟使能寄存器pc13
	//复位和时钟控制RCC的存储器映像地址：0x40021000
	//偏移地址：0x18
	*(uint32_t *)(0x40021000+0x18)=16;
	
	//初始化端口
	//GPIOC存储器映像地址0x40011000
	//pc13在高位寄存器配置，偏移地址：0x04
	//配置GPIO的输出模式，和速率
	*(uint32_t *)(0x40011000+0x04)=0x300000;
	
	
	//pc13端口输出低电平
	//GPIOC存储器映像地址0x40011000
	//数据输出寄存器偏移地址0x0c
	
	//找到13位置输出低低电平，1101 1111 1111 1111
	*(uint32_t *)(0x40011000+0x0C)=0xDFFF;
	while(1)
	{
	}
}
