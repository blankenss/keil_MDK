//key.c

#include "key.h"

//按键初始化
void key_init(void){
    RCC_APB2PeriphClockCmd(RCC_APB2Periph_GPIOA,ENABLE);
	RCC_APB2PeriphClockCmd(RCC_APB2Periph_AFIO, ENABLE);	// 使能 AFIO 时钟
	GPIO_PinRemapConfig(GPIO_Remap_SWJ_JTAGDisable, ENABLE);// 关闭JTAG 和 SWD 功能
	GPIO_PinRemapConfig(GPIO_Remap_SWJ_Disable, ENABLE);	// 关闭JTAG 和 SWD 功能

    GPIO_InitTypeDef def;
    def.GPIO_Mode=GPIO_Mode_IPU;
    def.GPIO_Pin=GPIO_Pin_12| GPIO_Pin_13|GPIO_Pin_14|GPIO_Pin_15; 
    GPIO_Init(GPIOA,&def);  
}

//1.库函数操作
//按键扫描
u8 key_scan(u8 mode)
{
    static u8 flag=1;
    if(mode) flag=1;
    if(flag && !GPIO_ReadInputDataBit(GPIOA,GPIO_Pin_15))
    {   flag=0;
        delay_ms(10);//延时消抖
        if(!GPIO_ReadInputDataBit(GPIOA,GPIO_Pin_15)) return 1;
    }else
    if(flag && !GPIO_ReadInputDataBit(GPIOA,GPIO_Pin_14))
    {   flag=0;
        delay_ms(10);//延时消抖
        if(!GPIO_ReadInputDataBit(GPIOA,GPIO_Pin_14)) return 2;
    }else 
    if(flag && !GPIO_ReadInputDataBit(GPIOA,GPIO_Pin_13))
    {   flag=0;
        delay_ms(10);//延时消抖
        if(!GPIO_ReadInputDataBit(GPIOA,GPIO_Pin_13)) return 3;
    }else
    if(flag && !GPIO_ReadInputDataBit(GPIOA,GPIO_Pin_12))
    {   flag=0;
        delay_ms(10);//延时消抖
        if(!GPIO_ReadInputDataBit(GPIOA,GPIO_Pin_12)) return 4;
    }else
    if(GPIO_ReadInputDataBit(GPIOA,GPIO_Pin_15)&&GPIO_ReadInputDataBit(GPIOA,GPIO_Pin_14)&&
        GPIO_ReadInputDataBit(GPIOA,GPIO_Pin_13)&&GPIO_ReadInputDataBit(GPIOA,GPIO_Pin_12))
        {
            flag=1;
        }
    return 0;
}

