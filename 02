systick.c
#include "systick.h"

static u8 fac_us = 0;     // us延时倍乘数
static u16 fac_ms = 0;    // ms延时倍乘数

// 初始化延迟函数
void delay_init(void)
{
    SysTick_CLKSourceConfig(SysTick_CLKSource_HCLK_Div8);  // 选择HCLK/8
    fac_us = SystemCoreClock / 8000000;  // 在8分频下，系统时钟周期数/us
    fac_ms = (u16)fac_us * 1000;         // 在8分频下，系统时钟周期数/ms
}

// 微秒延时函数
void delay_us(u32 nus)
{
    u32 temp;
    
    // 检查参数范围（24位最大值）
    if(nus > 1864135) nus = 1864135;  // 0xFFFFFF/fac_us
    
    SysTick->LOAD = nus * fac_us;      // 设置重装载值
    SysTick->VAL = 0x00;               // 清空计数器
    SysTick->CTRL |= SysTick_CTRL_ENABLE_Msk;  // 启动计数器
    
    // 等待计时完成
    do {
        temp = SysTick->CTRL;
    } while((temp & 0x01) && !(temp & (1<<16)));  // 检查使能和计数完成标志
    
    SysTick->CTRL &= ~SysTick_CTRL_ENABLE_Msk;  // 关闭计数器
    SysTick->VAL = 0x00;               // 清空计数器
}

// 毫秒延时函数
void delay_ms(u32 nms)  // 改为u32支持更长时间
{
    u32 temp;
    
    // 检查参数范围
    if(nms > 1864) nms = 1864;  // 0xFFFFFF/fac_ms
    
    SysTick->LOAD = nms * fac_ms;      // 设置重装载值
    SysTick->VAL = 0x00;               // 清空计数器
    SysTick->CTRL |= SysTick_CTRL_ENABLE_Msk;  // 启动计数器
    
    // 等待计时完成
    do {
        temp = SysTick->CTRL;
    } while((temp & 0x01) && !(temp & (1<<16)));
    
    SysTick->CTRL &= ~SysTick_CTRL_ENABLE_Msk;  // 修正：使用~操作
    SysTick->VAL = 0x00;               // 清空计数器
}
